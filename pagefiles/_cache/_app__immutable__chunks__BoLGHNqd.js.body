/span></span></span></span></span></span><span style=\\"font-size:14.0000pt\\"><span style=\\"background:#ffffff\\"><span style=\\"font-family:'Times New Roman'\\"><span style=\\"color:#000000\\"><span style=\\"letter-spacing:0.0000pt\\"><span style=\\"font-weight:normal\\"><span style=\\"font-style:normal\\"><font face=\\"Times New Roman, Times, serif\\">8</font></span></span></span></span></span></span></span><span style=\\"font-size:14.0000pt\\"><span style=\\"background:#ffffff\\"><span style=\\"font-family:'Times New Roman'\\"><span style=\\"color:#000000\\"><span style=\\"letter-spacing:0.0000pt\\"><span style=\\"font-weight:normal\\"><span style=\\"font-style:normal\\">3.</span></span></span></span></span></span></span></span></span></span><br>"},{"name":"B","content":"<span style=\\"font-size:10.5pt\\"><span style=\\"background:#ffffff\\"><span style=\\"font-family:Calibri\\"><span style=\\"font-size:14.0000pt\\"><span style=\\"background:#ffffff\\"><span style=\\"font-family:'Times New Roman'\\"><span style=\\"color:#000000\\"><span style=\\"letter-spacing:0.0000pt\\"><span style=\\"font-weight:normal\\"><span style=\\"font-style:normal\\">Every 2 years, t</span></span></span></span></span></span></span><span style=\\"font-size:14.0000pt\\"><span style=\\"background:#ffffff\\"><span style=\\"font-family:'Times New Roman'\\"><span style=\\"color:#000000\\"><span style=\\"letter-spacing:0.0000pt\\"><span style=\\"font-weight:normal\\"><span style=\\"font-style:normal\\"><font face=\\"Times New Roman, Times, serif\\">h</font></span></span></span></span></span></span></span><span style=\\"font-size:14.0000pt\\"><span style=\\"background:#ffffff\\"><span style=\\"font-family:'Times New Roman'\\"><span style=\\"color:#000000\\"><span style=\\"letter-spacing:0.0000pt\\"><span style=\\"font-weight:normal\\"><span style=\\"font-style:normal\\">e balance increases by about&nbsp;</span></span></span></span></span></span></span><span style=\\"font-size:14.0000pt\\"><span style=\\"background:#ffffff\\"><span style=\\"font-family:'Times New Roman'\\"><span style=\\"color:#000000\\"><span style=\\"letter-spacing:0.0000pt\\"><span style=\\"font-weight:normal\\"><span style=\\"font-style:normal\\"><font face=\\"Times New Roman, Times, serif\\">8</font></span></span></span></span></span></span></span><span style=\\"font-size:14.0000pt\\"><span style=\\"background:#ffffff\\"><span style=\\"font-family:'Times New Roman'\\"><span style=\\"color:#000000\\"><span style=\\"letter-spacing:0.0000pt\\"><span style=\\"font-weight:normal\\"><span style=\\"font-style:normal\\">3.</span></span></span></span></span></span></span></span></span></span><br>"},{"name":"C","content":"<span style=\\"font-size:20px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">At the end of every 6-month&nbsp;interval, the balance increases by about 0.3%&nbsp;of the balance at the beginning of the 6-month interval.</span></span><br>"},{"name":"D","content":"<span style=\\"font-size:20px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">At the end cf every 2-year interval. the balance increases&nbsp;by about 0.3%&nbsp;of&nbsp;the balance at the beginning of the 2-year interval.</span></span><br>"}],"correct":"<span style=\\"font-size:20px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">At the end of every 6-month&nbsp;interval, the balance increases by about 0.3%&nbsp;of the balance at the beginning of the 6-month interval.</span></span><br>","solution":""},{"type":"choice","article":"<span style=\\"font-family:Times New Roman,Times,serif;\\"><span style=\\"font-size:20px;\\">Which of the following is a factor of the&nbsp;expression <span class=\\"mq-math-mode\\" latex-data=\\"2x^2+\\\\left(18r+5\\\\right)x+45r\\"><span class=\\"mq-textarea\\"><textarea autocapitalize=\\"off\\" autocomplete=\\"off\\" autocorrect=\\"off\\" contenteditable=\\"false\\" data-cke-editable=\\"1\\" spellcheck=\\"false\\" x-palm-disable-ste-all=\\"true\\