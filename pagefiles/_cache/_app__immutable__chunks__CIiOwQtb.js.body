const a=JSON.parse(`[{"type":"choice","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">The number of muskrat in a 134-acre area is estimated to be 2,278. What is the estimated population density, in muskrat per acre, of this area?</span></span><br>","question":"","options":[{"name":"A","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">17</span></span><br>"},{"name":"B","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">134</span></span><br>"},{"name":"C","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">151</span></span><br>"},{"name":"D","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">2,295</span></span><br>"}],"correct":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">17</span></span><br>","solution":""},{"type":"choice","article":"<img alt=\\"\\" src=\\"/images/8f92b1cc8a84fa5943a2a43e4c0a8f49.png\\" style=\\"width: 400px; height: 300px;\\">​​​​​​​<br><span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">The triangle shown has one side with a length of x inches and two sides each with a length of y inches. The perimeter of the triangle is 69 inches. Which equation represents this situation?</span></span><br>","question":"","options":[{"name":"A","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">x+y=69</span></span><br>"},{"name":"B","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">2x+y=69</span></span><br>"},{"name":"C","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">x+2y=69</span></span><br>"},{"name":"D","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">2x+2y=69</span></span><br>"}],"correct":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">x+2y=69</span></span><br>","solution":""},{"type":"write","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">A jar has 330 buttons, and 20% of these buttons are green. How many buttons in the jar are green?</span></span><br>","question":"","options":[],"correct":"66","solution":""},{"type":"write","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">In the ancient Roman measurement system, a leuga was a unit of length that was equal to 7,500 pedes. In this measurement system, how many pedes were equivalent to 3.8 leugas?</span></span><br>","question":"","options":[],"correct":"28500","solution":""},{"type":"choice","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">There are a total of 1,200 milligrams of phosphorus in a sample of soil. Each kilogram of this sample contains 600 milligrams of phosphorus. Which equation represents this situation, where x is the mass, in kilograms, of the sample of soil?</span></span><br>","question":"","options":[{"name":"A","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">x+600=1,200</span></span><br>"},{"name":"B","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">1,200x=600</span></span><br>"},{"name":"C","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">x+1,200=600</span></span><br>"},{"name":"D","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">600x=1,200</span></span><br>"}],"correct":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">600x=1,200</span></span><br>","solution":""},{"type":"choice","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">The function f is defined by f(x)=</span></span><span class=\\"mq-math-mode\\" latex-data=\\"\\\\frac{1}{2}\\"><span class=\\"mq-textarea\\"><textarea autocapitalize=\\"off\\" autocomplete=\\"off\\" autocorrect=\\"off\\" spellcheck=\\"false\\" x-palm-disable-ste-all=\\"true\\" data-cke-editable=\\"1\\" contenteditable=\\"false\\"></textarea></span><span class=\\"mq-root-block\\" mathquill-block-id=\\"1\\"><span class=\\"mq-fraction mq-non-leaf\\" mathquill-command-id=\\"3\\"><span class=\\"mq-numerator\\" mathquill-block-id=\\"4\\"><span mathquill-command-id=\\"7\\">1</span></span><span class=\\"mq-denominator\\" mathquill-block-id=\\"5\\"><span mathquill-command-id=\\"8\\">2</span></span><span style=\\"display:inline-block;width:0\\">​</span></span></span></span><span>&nbsp;</span>​​​​​​​<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">(x+12). What is the value of f(6)?</span></span><br>","question":"","options":[{"name":"A","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">36</span></span><br>"},{"name":"B","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">24</span></span><br>"},{"name":"C","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">18</span></span><br>"},{"name":"D","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">9</span></span><br>"}],"correct":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">9</span></span><br>","solution":""},{"type":"choice","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">If 9x+4=32, what is the value of 3(9x+4)?</span></span><br>","question":"","options":[{"name":"A","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">84</span></span><br>"},{"name":"B","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">96</span></span><br>"},{"name":"C","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">108</span></span><br>"},{"name":"D","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">128</span></span><br>"}],"correct":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">96</span></span><br>","solution":""},{"type":"write","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">Triangles ABC and DEF are congruent, where A corresponds to D, and B and E are right angles. The measure of angle A is 64°. What is the measure, in degrees, of angle F?</span></span><br>","question":"","options":[],"correct":"26","solution":""},{"type":"choice","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">A savings account is opened with an initial deposit of $7,000. The amount of money in the account t years after the initial deposit is given by the function </span></span><span class=\\"mq-math-mode\\" latex-data=\\"f\\\\left(t\\\\right)=7,000\\\\left(1.01\\\\right)^{2t}\\"><span class=\\"mq-textarea\\"><textarea autocapitalize=\\"off\\" autocomplete=\\"off\\" autocorrect=\\"off\\" spellcheck=\\"false\\" x-palm-disable-ste-all=\\"true\\" data-cke-editable=\\"1\\" contenteditable=\\"false\\"></textarea></span><span class=\\"mq-root-block\\" mathquill-block-id=\\"1\\"><var class=\\"mq-f\\" mathquill-command-id=\\"3\\">f</var><span class=\\"mq-non-leaf\\" mathquill-command-id=\\"4\\"><span class=\\"mq-scaled mq-paren\\" style=\\"transform: scale(1, 1.2);\\">(</span><span class=\\"mq-non-leaf\\" mathquill-block-id=\\"5\\"><var mathquill-command-id=\\"8\\">t</var></span><span class=\\"mq-scaled mq-paren\\" style=\\"transform: scale(1, 1.2);\\">)</span></span><span class=\\"mq-binary-operator\\" mathquill-command-id=\\"9\\">=</span><span mathquill-command-id=\\"10\\">7</span><span mathquill-command-id=\\"11\\">,</span><span mathquill-command-id=\\"12\\">0</span><span mathquill-command-id=\\"13\\">0</span><span mathquill-command-id=\\"14\\">0</span><span class=\\"mq-non-leaf\\" mathquill-command-id=\\"26\\"><span class=\\"mq-scaled mq-paren\\" style=\\"transform: scale(1, 1.2);\\">(</span><span class=\\"mq-non-leaf\\" mathquill-block-id=\\"27\\"><span mathquill-command-id=\\"22\\">1</span><span mathquill-command-id=\\"23\\">.</span><span mathquill-command-id=\\"24\\">0</span><span mathquill-command-id=\\"25\\">1</span></span><span class=\\"mq-scaled mq-paren\\" style=\\"transform: scale(1, 1.2);\\">)</span></span><span class=\\"mq-supsub mq-non-leaf mq-sup-only\\" mathquill-command-id=\\"17\\"><span class=\\"mq-sup\\" mathquill-block-id=\\"18\\"><span mathquill-command-id=\\"20\\">2</span><var mathquill-command-id=\\"21\\">t</var></span></span></span></span><span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">. Which of the following is the best interpretation of the statement \\"f(3) is approximately equal to 7,430.64\\"&nbsp;in this context?</span></span><br>","question":"","options":[{"name":"A","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">3 years after the initial deposit, the amount of money, in dollars, in the account is 7,430.64.</span></span><br>"},{"name":"B","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">Every 3 years, the amount of money, in dollars, in the account increases by 7,430.64.</span></span><br>"},{"name":"C","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">3 years after the initial deposit, the amount of money, in dollars, in the account has increased by 7,430.64.</span></span><br>"},{"name":"D","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">Every 3 years, the amount of money, in dollars, in the account decreases by 7,430.64.</span></span><br>"}],"correct":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">3 years after the initial deposit, the amount of money, in dollars, in the account is 7,430.64.</span></span><br>","solution":""},{"type":"choice","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">y=(x-3)(x+10)<br>Which table gives four values of x and the corresponding values of y for the given quadratic equation?</span></span><br>","question":"","options":[{"name":"A","content":"<img alt=\\"\\" src=\\"/images/772697e45bbf3f55cec2fff18458697a.png\\" style=\\"width: 542px; height: 130px;\\">​​​​​​​<br>"},{"name":"B","content":"<img alt=\\"\\" src=\\"/images/f656ae9624a78c74b056c3aafbc33672.png\\" style=\\"width: 542px; height: 133px;\\">​​​​​​​<br>"},{"name":"C","content":"<img alt=\\"\\" src=\\"/images/16c167faf1eaa0ccd91ce4c34f356cba.png\\" style=\\"width: 546px; height: 137px;\\">​​​​​​​<br>"},{"name":"D","content":"<img alt=\\"\\" src=\\"/images/6bee35f8de3e21bcf36975ca918fe121.png\\" style=\\"width: 541px; height: 130px;\\">​​​​​​​<br>"}],"correct":"<img alt=\\"\\" src=\\"/images/16c167faf1eaa0ccd91ce4c34f356cba.png\\" style=\\"width: 546px; height: 137px;\\">​​​​​​​<br>","solution":""},{"type":"choice","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">In the linear function f, f(0)=3 and f(5)=3. Which equation defines f?</span></span><br>","question":"","options":[{"name":"A","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">f(x)=0</span></span><br>"},{"name":"B","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">f(x)=5</span></span><br>"},{"name":"C","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">f(x)=3</span></span><br>"},{"name":"D","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">f(x)=x+3</span></span><br>"}],"correct":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">f(x)=3</span></span><br>","solution":""},{"type":"choice","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">An arborist studying forestland in Illinois estimates that there are at least 50 and no more than 60 hickory trees per acre in a certain forest. Which of the following best represents the arborist's estimate of the number of hickory trees, x, that are in a 3-acre section of this forest?</span></span><br>","question":"","options":[{"name":"A","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\"><span class=\\"mq-math-mode\\" latex-data=\\"180\\\\le x\\\\le360\\"><span class=\\"mq-textarea\\"><textarea autocapitalize=\\"off\\" autocomplete=\\"off\\" autocorrect=\\"off\\" spellcheck=\\"false\\" x-palm-disable-ste-all=\\"true\\" data-cke-editable=\\"1\\" contenteditable=\\"false\\"></textarea></span><span class=\\"mq-root-block\\" mathquill-block-id=\\"1\\"><span mathquill-command-id=\\"3\\">1</span><span mathquill-command-id=\\"5\\">8</span><span mathquill-command-id=\\"7\\">0</span><span class=\\"mq-binary-operator\\" mathquill-command-id=\\"21\\">≤</span><var mathquill-command-id=\\"26\\">x</var><span class=\\"mq-binary-operator\\" mathquill-command-id=\\"24\\">≤</span><span mathquill-command-id=\\"27\\">3</span><span mathquill-command-id=\\"28\\">6</span><span mathquill-command-id=\\"29\\">0</span></span></span>&nbsp;</span></span><br>"},{"name":"B","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\"><span class=\\"mq-math-mode\\" latex-data=\\"180\\\\le x\\\\le360\\"><span class=\\"mq-textarea\\"><textarea autocapitalize=\\"off\\" autocomplete=\\"off\\" autocorrect=\\"off\\" spellcheck=\\"false\\" x-palm-disable-ste-all=\\"true\\" data-cke-editable=\\"1\\" contenteditable=\\"false\\"></textarea></span><span class=\\"mq-root-block\\" mathquill-block-id=\\"1\\"><span mathquill-command-id=\\"3\\">1</span><span mathquill-command-id=\\"5\\">5</span><span mathquill-command-id=\\"7\\">0</span><span class=\\"mq-binary-operator\\" mathquill-command-id=\\"21\\">≤</span><var mathquill-command-id=\\"26\\">x</var><span class=\\"mq-binary-operator\\" mathquill-command-id=\\"24\\">≤</span><span mathquill-command-id=\\"29\\">180</span></span></span>&nbsp;</span></span><br>"},{"name":"C","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\"><span class=\\"mq-math-mode\\" latex-data=\\"180\\\\le x\\\\le360\\"><span class=\\"mq-textarea\\"><textarea autocapitalize=\\"off\\" autocomplete=\\"off\\" autocorrect=\\"off\\" spellcheck=\\"false\\" x-palm-disable-ste-all=\\"true\\" data-cke-editable=\\"1\\" contenteditable=\\"false\\"></textarea></span><span class=\\"mq-root-block\\" mathquill-block-id=\\"1\\"><span mathquill-command-id=\\"5\\">53</span><span class=\\"mq-binary-operator\\" mathquill-command-id=\\"21\\">≤</span><var mathquill-command-id=\\"26\\">x</var><span class=\\"mq-binary-operator\\" mathquill-command-id=\\"24\\">≤</span><span mathquill-command-id=\\"29\\">63</span></span></span>&nbsp;</span></span><br>"},{"name":"D","content":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\"><span class=\\"mq-math-mode\\" latex-data=\\"180\\\\le x\\\\le360\\"><span class=\\"mq-textarea\\"><textarea autocapitalize=\\"off\\" autocomplete=\\"off\\" autocorrect=\\"off\\" spellcheck=\\"false\\" x-palm-disable-ste-all=\\"true\\" data-cke-editable=\\"1\\" contenteditable=\\"false\\"></textarea></span><span class=\\"mq-root-block\\" mathquill-block-id=\\"1\\"><span mathquill-command-id=\\"5\\">50</span><span class=\\"mq-binary-operator\\" mathquill-command-id=\\"21\\">≤</span><var mathquill-command-id=\\"26\\">x</var><span class=\\"mq-binary-operator\\" mathquill-command-id=\\"24\\">≤</span><span mathquill-command-id=\\"29\\">60</span></span></span>&nbsp;</span></span><br>"}],"correct":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\"><span class=\\"mq-math-mode\\" latex-data=\\"180\\\\le x\\\\le360\\"><span class=\\"mq-textarea\\"><textarea autocapitalize=\\"off\\" autocomplete=\\"off\\" autocorrect=\\"off\\" spellcheck=\\"false\\" x-palm-disable-ste-all=\\"true\\" data-cke-editable=\\"1\\" contenteditable=\\"false\\"></textarea></span><span class=\\"mq-root-block\\" mathquill-block-id=\\"1\\"><span mathquill-command-id=\\"3\\">1</span><span mathquill-command-id=\\"5\\">5</span><span mathquill-command-id=\\"7\\">0</span><span class=\\"mq-binary-operator\\" mathquill-command-id=\\"21\\">≤</span><var mathquill-command-id=\\"26\\">x</var><span class=\\"mq-binary-operator\\" mathquill-command-id=\\"24\\">≤</span><span mathquill-command-id=\\"29\\">180</span></span></span>&nbsp;</span></span><br>","solution":""},{"type":"write","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">For the polynomial function p, the graph of y=p(x) in the xy-plane crosses through the points (-4,0), (0,9), (6,0), and (17,0). What is the value of p(0)?</span></span><br>","question":"","options":[],"correct":"9","solution":""},{"type":"write","article":"<span style=\\"font-size:18px;\\"><span style=\\"font-family:Times New Roman,Times,serif;\\">The graph of -6x+4.4y=-660 in the xy-plane has intercepts at (a,0) and